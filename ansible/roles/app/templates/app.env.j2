{#- The environment of one app: the contract of ecoctl's app_env (plan.py). For eco_target hosts, then the few names AgentPG would have injected. -#}
{%- set a = eco_item -%}
{%- set k = a.key -%}
{%- set p = a.env_prefix -%}
{%- set e = {} -%}
{%- set s = eco_secrets -%}
{#- ---- the contract of ecoctl.plan.app_env ---- -#}
{%- for n, v in a.env.items() %}{% set _ = e.update({n: v}) %}{% endfor -%}
{%- for n in a.generate %}{% if not (a.vault == 'password' and n == a.encryption_key_name) %}{% set _ = e.update({n: s[k ~ '/' ~ n]}) %}{% endif %}{% endfor -%}
{%- if k == eco_fleet.llm.gateway and (eco_fleet.consumers or a.vault == 'password') -%}
  {%- set _ = e.update({p ~ '_API_KEY': s[k ~ '/' ~ p ~ '_API_KEY']}) -%}
{%- endif -%}
{%- if eco_fleet.consumers and k == eco_fleet.llm.gateway -%}
  {%- set _ = e.update({p ~ '_DEFAULT_CHAT_ALIAS': eco_fleet.llm.chat_alias,
                        p ~ '_DEFAULT_EMBED_ALIAS': eco_fleet.llm.embed_alias,
                        p ~ '_DEFAULT_EMBED_DIM': eco_fleet.llm.embed_dimensions | string}) -%}
{%- endif -%}
{%- if k == 'identity' -%}
  {%- set _ = e.update({'IDENTITY_API_KEY': s['identity/IDENTITY_API_KEY']}) -%}
{%- else -%}
  {%- set oc = eco_oidc_clients.get(k, {}) -%}
  {%- if eco_urls.identity -%}
  {%- set _ = e.update({p ~ '_OIDC_ISSUER': eco_urls.identity}) -%}
  {%- if a.web -%}
    {%- set _ = e.update({p ~ '_OIDC_CLIENT_ID': oc.get('client_id', k) if eco_identity_mode == 'oidc' else k}) -%}
    {%- set sec = oc.get('client_secret', '') if eco_identity_mode == 'oidc' else eco_issued.get(k ~ '/client_secret', '') -%}
    {%- if sec %}{% set _ = e.update({p ~ '_OIDC_CLIENT_SECRET': sec}) %}{% endif -%}
  {%- endif -%}
  {%- if a.service -%}
    {%- set _ = e.update({p ~ '_SERVICE_CLIENT_ID': oc.get('service_client_id', a.service_client_id) if eco_identity_mode == 'oidc' else a.service_client_id}) -%}
    {%- set sec = oc.get('service_client_secret', '') if eco_identity_mode == 'oidc' else eco_issued.get(k ~ '/service_secret', '') -%}
    {%- if sec %}{% set _ = e.update({p ~ '_SERVICE_CLIENT_SECRET': sec}) %}{% endif -%}
  {%- endif -%}
  {%- endif -%}
  {%- for callee, var in a.url_vars.items() -%}
    {%- if eco_urls.get(callee) %}{% set _ = e.update({var: eco_urls[callee]}) %}{% endif -%}
  {%- endfor -%}
  {%- if a.llm -%}
    {%- set base = eco_llm_base_url if eco_llm_mode == 'openai' else (eco_urls.get(eco_fleet.llm.gateway) ~ '/v1' if eco_urls.get(eco_fleet.llm.gateway) else '') -%}
    {%- if base %}{% set _ = e.update({'LLM_BASE_URL': base}) %}{% endif -%}
    {%- set _ = e.update({'LLM_CHAT_MODEL': eco_fleet.llm.chat_alias, 'EMBEDDING_MODEL': eco_fleet.llm.embed_alias,
                          'EMBEDDING_DIM': eco_fleet.llm.embed_dimensions | string}) -%}
    {%- set key = eco_llm_api_key if eco_llm_mode == 'openai' else eco_issued.get(k ~ '/llm_key', '') -%}
    {%- if key %}{% set _ = e.update({'LLM_API_KEY': key}) %}{% endif -%}
  {%- endif -%}
{%- endif -%}
{#- ---- eco_target hosts only: what AgentPG injects on its platform and a plain host must be told ---- -#}
{%- if eco_target | default('agentpg') == 'hosts' -%}
{%- set _ = e.update({'DATABASE_URL': eco_database_url}) -%}
{%- if k == 'identity' %}{% set _ = e.update({'IDENTITY_PUBLIC_URL': eco_urls.identity}) %}{% endif -%}
{%- if a.port != 8000 %}{% set _ = e.update({'PORT': a.port | string}) %}{% endif -%}
{%- if eco_ca_path %}{% set _ = e.update({'SSL_CERT_FILE': '/etc/eco/ca.crt'}) %}{% endif -%}
{%- endif -%}
{% for n, v in e | dictsort %}
{{ n }}={{ v }}
{% endfor %}
