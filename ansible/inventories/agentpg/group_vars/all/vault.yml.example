---
# Copy to vault.yml, fill in what you need, then:  ansible-vault encrypt inventories/agentpg/group_vars/all/vault.yml
# Everything is optional: generated secrets live in .secrets/ and need no entry here.
eco_secret_overrides:
  # "identity/IDENTITY_API_KEY": "a key you already have"        # existing identity provider: its admin API key
  # "llmgw/LLMGW_API_KEY": "the operator key of an existing gateway"
# eco_llm_api_key: "sk-..."                                       # eco_llm_mode: openai
# eco_oidc_clients:                                               # eco_identity_mode: oidc
#   trustdesk: {client_id: trustdesk, client_secret: "..."}
# eco_admin_password: "a long passphrase"                          # opens the vaults of identity and the gateway (`vault: password`); omit it to have a strong one generated into .secrets/<fleet>/vault/admin_password,
#                                                                  # or use ECO_ADMIN_PASSWORD / -e eco_admin_password_prompt=true. The platform never stores it; keep it in a password manager
