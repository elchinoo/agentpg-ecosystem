---
# Copy to vault.yml, fill in what you need, then:  ansible-vault encrypt inventories/own-infra/group_vars/all/vault.yml
# Everything is optional: generated secrets live encrypted in .secrets/<fleet>/state.sealed and need no entry here.
eco_secret_overrides:
  # "identity/IDENTITY_API_KEY": "a key you already have"        # existing identity provider: its admin API key
  # "llmgw/LLMGW_API_KEY": "the operator key of an existing gateway"
# eco_llm_api_key: "sk-..."                                       # eco_llm_mode: openai
# eco_db_login_password: "..."                                    # a database administrator reached over TCP
# eco_oidc_clients:                                               # eco_identity_mode: oidc
#   trustdesk: {client_id: trustdesk, client_secret: "..."}
# The seal passphrase is NOT set here: export ECOCTL_SEAL_PASSPHRASE in the shell that runs ansible-playbook, or pass -e eco_seal_passphrase_prompt=true. It is stored nowhere.
